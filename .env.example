# ---------------------------------------------------------------------------
# ShadowPackets configuration. Copy to `.env` and edit as needed.
# Every value is optional; the defaults are local-only and conservative.
# ---------------------------------------------------------------------------

# Where uploads, analyses, extracted objects and the SQLite database live.
# SHADOWPACKETS_DATA_DIR=./data

# Maximum accepted upload size, in megabytes.
SHADOWPACKETS_MAX_UPLOAD_MB=512

# Absolute paths to the TShark binaries. Leave unset to auto-detect
# (PATH, then the usual Wireshark install locations). For a local run,
# `python backend/tools/init_env.py` fills the default paths for this OS.
# SHADOWPACKETS_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
# SHADOWPACKETS_CAPINFOS_PATH=C:\Program Files\Wireshark\capinfos.exe

# Wall-clock budget for a single TShark invocation, in seconds.
SHADOWPACKETS_TSHARK_TIMEOUT_S=300

# Largest file that may be extracted from a capture, in bytes (default 50 MB).
SHADOWPACKETS_MAX_OBJECT_BYTES=52428800

# How much of an HTTP request/response body is kept for display, in bytes.
SHADOWPACKETS_BODY_PREVIEW_BYTES=262144

# Hard cap on rows returned by a single CSV export.
SHADOWPACKETS_MAX_EXPORT_ROWS=200000

# Keep the original capture after processing (required for packet detail and
# stream views; disabling it makes those features unavailable).
SHADOWPACKETS_RETAIN_UPLOADS=true

# Background worker threads used for analysis jobs.
SHADOWPACKETS_WORKER_THREADS=2

# Recompute the baseline findings of every analysis after the baseline network is
# chosen, switched or cleared. The sweep runs in the background; setting this to
# false leaves the stored findings alone until "Recalculate" is pressed on PCAP
# Files (the test suite sets it to false so a sweep cannot race a test).
SHADOWPACKETS_BASELINE_AUTO_RECALC=true

# Import the vendored Suricata rules on startup when the rule table is empty.
SHADOWPACKETS_SURICATA_AUTO_SEED=true

# Bind address. 127.0.0.1 keeps the service local-only.
# Setting this to 0.0.0.0 exposes the API on the LAN — see the README warning
# about authentication before doing so.
SHADOWPACKETS_HOST=127.0.0.1
SHADOWPACKETS_PORT=8000

# Host port published by docker-compose (the container still listens on
# SHADOWPACKETS_PORT). Compose derives the startup-log URL from this value.
SHADOWPACKETS_PORT_HOST=8080

# Comma-separated list, or a JSON array. Only used by the Vite dev server.
SHADOWPACKETS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
SHADOWPACKETS_LOG_LEVEL=INFO

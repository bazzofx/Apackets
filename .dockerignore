# Build context exclusions. The image needs source, not artefacts:
# the frontend is compiled inside the build, and data/ is a volume at runtime.

.git
.gitignore
.tmp
.cache
.config
data
docs
Documentation
backend/tests
backend/.venv
backend/__pycache__
**/__pycache__
**/*.pyc
frontend/node_modules
frontend/dist
frontend/.vite
*.db
*.db-wal
*.db-shm
*.pcap
*.pcapng
*.cap
.env
.env.*
!.env.example
README.md

# ---------------------------------------------------------------------------
# APackets configuration. Copy to `.env` and edit as needed.
# Every value is optional; the defaults are local-only and conservative.
# ---------------------------------------------------------------------------

# Where uploads, analyses, extracted objects and the SQLite database live.
# APACKETS_DATA_DIR=./data

# Maximum accepted upload size, in megabytes.
APACKETS_MAX_UPLOAD_MB=512

# Absolute paths to the TShark binaries. Leave unset to auto-detect
# (PATH, then the usual Wireshark install locations).
# APACKETS_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
# APACKETS_CAPINFOS_PATH=C:\Program Files\Wireshark\capinfos.exe

# Wall-clock budget for a single TShark invocation, in seconds.
APACKETS_TSHARK_TIMEOUT_S=300

# Largest file that may be extracted from a capture, in bytes (default 50 MB).
APACKETS_MAX_OBJECT_BYTES=52428800

# How much of an HTTP request/response body is kept for display, in bytes.
APACKETS_BODY_PREVIEW_BYTES=262144

# Hard cap on rows returned by a single CSV export.
APACKETS_MAX_EXPORT_ROWS=200000

# Keep the original capture after processing (required for packet detail and
# stream views; disabling it makes those features unavailable).
APACKETS_RETAIN_UPLOADS=true

# Background worker threads used for analysis jobs.
APACKETS_WORKER_THREADS=2

# Bind address. 127.0.0.1 keeps the service local-only.
# Setting this to 0.0.0.0 exposes the API on the LAN — see the README warning
# about authentication before doing so.
APACKETS_HOST=127.0.0.1
APACKETS_PORT=8000

# Comma-separated list, or a JSON array. Only used by the Vite dev server.
APACKETS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
APACKETS_LOG_LEVEL=INFO
